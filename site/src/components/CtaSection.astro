---
import CtaButtons from './CtaButtons.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  subtitle?: string;
}
const locale = (Astro.currentLocale ?? 'th') as Locale;
const L = t(locale);
const { title = L.ctaTitle, subtitle = L.ctaSubtitle } = Astro.props;
---

<section class="bg-gradient-to-r from-navy-900 to-brand-700 py-14 text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-4 text-center">
    <h2 class="text-2xl font-extrabold md:text-3xl">{title}</h2>
    <p class="max-w-2xl text-brand-100">{subtitle}</p>
    <CtaButtons />
  </div>
</section>
