---
import { SITE } from '../lib/site';
import { t, otherLocale, localeHome, type Locale } from '../lib/i18n';
import Logo from './Logo.astro';

interface Props {
  /** URL ของหน้านี้ในอีกภาษา (ถ้าไม่มีหน้าคู่ ให้ fallback เป็นหน้าแรกอีกภาษา) */
  altUrl?: string;
}
const { altUrl } = Astro.props;

const locale = (Astro.currentLocale ?? 'th') as Locale;
const L = t(locale);
const other = otherLocale(locale);
const switchUrl = altUrl ?? localeHome(other);

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' || href === '/en/' ? path === href : path.startsWith(href);
---

<!-- Top bar -->
<div class="bg-navy-900 text-white text-xs sm:text-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-1.5">
    <p class="flex items-center gap-1.5 truncate">
      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
      {L.topbarNote}
    </p>
    <div class="flex shrink-0 items-center gap-4">
      <a href={`tel:${SITE.phoneIntl}`} class="flex items-center gap-1.5 hover:text-brand-100">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/></svg>
        {SITE.phoneDisplay}
      </a>
      <a href={SITE.lineUrl} target="_blank" rel="noopener" class="hidden items-center gap-1.5 hover:text-brand-100 sm:flex">
        <span class="rounded bg-line-600 px-1.5 py-0.5 text-[10px] font-bold leading-none">LINE</span>
        {SITE.lineId}
      </a>
      <!-- Language switcher -->
      <div class="flex items-center gap-1 border-l border-white/20 pl-3 font-semibold" aria-label="Language / ภาษา">
        <a
          href={locale === 'th' ? path : switchUrl}
          hreflang="th"
          class:list={['rounded px-1.5 py-0.5 transition', locale === 'th' ? 'bg-white/15 text-white' : 'text-brand-100 hover:text-white']}
          aria-current={locale === 'th' ? 'true' : undefined}
        >ไทย</a>
        <span class="text-white/30" aria-hidden="true">|</span>
        <a
          href={locale === 'en' ? path : switchUrl}
          hreflang="en"
          class:list={['rounded px-1.5 py-0.5 transition', locale === 'en' ? 'bg-white/15 text-white' : 'text-brand-100 hover:text-white']}
          aria-current={locale === 'en' ? 'true' : undefined}
        >EN</a>
      </div>
    </div>
  </div>
</div>

<!-- Main header -->
<header class="sticky top-0 z-40 border-b border-brand-50 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5">
    <a href={localeHome(locale)} class="flex shrink-0 items-center gap-2.5" aria-label="Phuket Maid Service">
      <Logo class="h-10 w-10 shrink-0" />
      <span class="leading-tight">
        <span class="block whitespace-nowrap text-base font-extrabold tracking-tight text-navy-900 xl:text-lg">PHUKET <span class="text-brand-600">MAID SERVICE</span></span>
        <span class="block whitespace-nowrap text-[11px] text-ink-600 lg:hidden 2xl:block">{L.logoTagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-x-5 lg:flex xl:gap-x-6" aria-label="Main menu">
      {L.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'whitespace-nowrap text-sm font-semibold transition-colors hover:text-brand-600',
            isActive(item.href) ? 'text-brand-600' : 'text-navy-900',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.lineUrl}
        target="_blank"
        rel="noopener"
        class="hidden whitespace-nowrap rounded-lg bg-line-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-line-700 md:inline-flex"
      >
        {L.ctaLineNav}
      </a>
      <a
        href={`tel:${SITE.phoneIntl}`}
        class="hidden whitespace-nowrap rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700 md:inline-flex"
      >
        {L.ctaCallNav} {SITE.phoneDisplay}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-lg border border-brand-100 p-2 text-navy-900 lg:hidden"
        aria-label={L.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden border-t border-brand-50 bg-white lg:hidden" aria-label="Mobile menu">
    <div class="mx-auto max-w-6xl space-y-1 px-4 py-3">
      {L.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block rounded-lg px-3 py-2.5 text-sm font-semibold',
            isActive(item.href) ? 'bg-brand-50 text-brand-600' : 'text-navy-900 hover:bg-brand-50',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
