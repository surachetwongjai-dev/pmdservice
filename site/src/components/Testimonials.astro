---
import SectionHeading from './SectionHeading.astro';
import { t, type Locale } from '../lib/i18n';

// ห้ามสร้างรีวิวปลอมพร้อมชื่อคน (BRIEF ข้อ 10) และห้ามโชว์ดาวถ้ายังไม่มีคะแนนจริง
// -> แสดงเป็น "สรุปฟีดแบ็กที่ได้รับบ่อย" + ประเภทลูกค้าที่ดูแลจริง
// เมื่อมีรีวิวจริงจาก Google Business Profile ค่อยเพิ่มการ์ดรีวิว + AggregateRating schema
const locale = (Astro.currentLocale ?? 'th') as Locale;
const L = t(locale);

const icons = [
  // ตรงเวลา — นาฬิกา
  'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 10.6V6h-2v7.4l5.2 3.1 1-1.7-4.2-2.2Z',
  // สะอาดจริง — ประกาย
  'M12 2 9.9 8.4 3.5 10.5l6.4 2.1L12 19l2.1-6.4 6.4-2.1-6.4-2.1L12 2Zm6.5 11.5-.9 2.6-2.6.9 2.6.9.9 2.6.9-2.6 2.6-.9-2.6-.9-.9-2.6Z',
  // มืออาชีพ — โล่
  'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm-1.2 13.6-3-3 1.4-1.4 1.6 1.6 4-4L16.2 10l-5.4 5.6Z',
  // คุยง่าย — แชท
  'M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2ZM7 9h10v2H7V9Zm0 4h7v2H7v-2ZM7 5h10v2H7V5Z',
];
---

<section class="bg-white py-16 md:py-24" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow={L.reviewsEyebrow} title={L.reviewsTitle} />
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-relaxed text-ink-600">{L.reviewsIntro}</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {L.reviewPoints.map((p, i) => (
        <div class="flex flex-col gap-3 rounded-2xl border border-brand-50 bg-white p-6 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d={icons[i % icons.length]} /></svg>
          </span>
          <h3 class="text-lg font-extrabold text-navy-900">{p.title}</h3>
          <p class="text-sm leading-relaxed text-ink-600">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl bg-brand-50 px-6 py-5 text-center">
      <p class="text-xs font-bold uppercase tracking-wide text-brand-700">{L.clientTypesLabel}</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {L.clientTypes.map((c) => (
          <span class="rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-navy-900 shadow-card">{c}</span>
        ))}
      </div>
    </div>
  </div>
</section>
