---
import SectionHeading from './SectionHeading.astro';

// ห้ามสร้างรีวิวปลอมพร้อมชื่อคน (BRIEF ข้อ 10) — ใช้ placeholder รอรีวิวจริง
const reviews = [
  { text: '[รอรีวิวจริงจากลูกค้า — งานแม่บ้านรายชั่วโมง]', name: '[รอชื่อลูกค้า]', role: 'เจ้าของบ้าน' },
  { text: '[รอรีวิวจริงจากลูกค้า — งานซักโซฟา/ที่นอน]', name: '[รอชื่อลูกค้า]', role: 'เจ้าของคอนโด' },
  { text: '[รอรีวิวจริงจากลูกค้า — งาน Deep Cleaning / พูลวิลล่า]', name: '[รอชื่อลูกค้า]', role: 'Airbnb Host' },
];
---

<section class="bg-white py-16 md:py-24" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow="Customer Testimonials" title="รีวิวจากลูกค้าของเรา" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {reviews.map((r) => (
        <figure class="flex flex-col gap-4 rounded-2xl border border-brand-50 bg-white p-6 shadow-card">
          <div class="flex gap-1 text-star-500" aria-label="5 ดาว">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2Z"/></svg>
            ))}
          </div>
          <blockquote class="text-sm leading-relaxed text-ink-600">{r.text}</blockquote>
          <figcaption class="mt-auto flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 font-bold text-brand-600" aria-hidden="true">?</span>
            <span>
              <span class="block text-sm font-bold">{r.name}</span>
              <span class="block text-xs text-ink-600">{r.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
