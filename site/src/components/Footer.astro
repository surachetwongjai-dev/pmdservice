---
import { SITE } from '../lib/site';
import { t, localeHome, type Locale } from '../lib/i18n';
import Logo from './Logo.astro';

const locale = (Astro.currentLocale ?? 'th') as Locale;
const L = t(locale);
const year = new Date().getFullYear();
// TODO(i18n): เมื่อแปลหน้า location เป็น EN แล้ว เปลี่ยนเป็น locale === 'en' ? '/en' : ''
// ตอนนี้หน้า location มีเฉพาะไทย จึงชี้ TH ทั้งสองภาษา เพื่อไม่ให้ลิงก์เสีย
const areaPrefix = '';
---

<footer class="bg-navy-900 pb-24 text-brand-100 md:pb-0">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href={localeHome(locale)} class="flex items-center gap-2.5" aria-label="Phuket Maid Service">
        <Logo class="h-11 w-11" />
        <span class="leading-tight">
          <span class="block text-base font-extrabold text-white">PHUKET MAID SERVICE</span>
          <span class="block text-[11px] text-brand-100/80">{SITE.legalName}</span>
        </span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-brand-100/80">{L.footerAbout}</p>
      <div class="mt-4 flex gap-3">
        <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="rounded-full bg-white/10 p-2 transition hover:bg-white/20">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href={SITE.lineUrl} target="_blank" rel="noopener" aria-label="LINE" class="rounded-full bg-white/10 p-2 transition hover:bg-white/20">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.5 3 2 6.6 2 11.1c0 4 3.6 7.4 8.4 8 .3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.6s6-3.5 8.2-6C21.7 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8Zm-3.1 10.5H6.7a.5.5 0 0 1-.5-.5V9.4a.5.5 0 0 1 1 0v3.1h1.7a.5.5 0 1 1 0 1Zm2 0a.5.5 0 0 1-1 0V9.4a.5.5 0 0 1 1 0v4.1Zm4.9 0a.5.5 0 0 1-.9.3l-2-2.8v2.5a.5.5 0 0 1-1 0V9.4a.5.5 0 0 1 .9-.3l2 2.8V9.4a.5.5 0 0 1 1 0v4.1Zm3.5-2.6a.5.5 0 1 1 0 1h-1.7v1.1h1.7a.5.5 0 1 1 0 1h-2.2a.5.5 0 0 1-.5-.5V9.4a.5.5 0 0 1 .5-.5h2.2a.5.5 0 1 1 0 1h-1.7v1h1.7Z"/></svg>
        </a>
      </div>
    </div>

    <nav aria-label={L.footerQuick}>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-white">{L.footerQuick}</h2>
      <ul class="space-y-2.5 text-sm">
        {L.footerQuickLinks.map((l) => (
          <li><a href={l.href} class="transition hover:text-white">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label={L.footerServices}>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-white">{L.footerServices}</h2>
      <ul class="space-y-2.5 text-sm">
        {L.footerServiceLinks.map((l) => (
          <li><a href={l.href} class="transition hover:text-white">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-white">{L.footerContact}</h2>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={`tel:${SITE.phoneIntl}`} class="flex items-center gap-2 font-semibold text-white hover:text-brand-100">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/></svg>
            {SITE.phoneDisplay} ({L.contactPerson})
          </a>
        </li>
        <li>LINE ID: <a href={SITE.lineUrl} target="_blank" rel="noopener" class="underline hover:text-white">{SITE.lineId}</a></li>
        <li>WhatsApp: <a href={SITE.whatsapp} target="_blank" rel="noopener" class="underline hover:text-white">+66 61 965 6292</a></li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>
        <li class="leading-relaxed">{SITE.address.full}</li>
        <li class="font-semibold text-white">{L.footerHoursLabel}: {L.openingHours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <nav class="mx-auto max-w-6xl px-4 py-4 text-center text-xs leading-relaxed text-brand-100/80" aria-label={L.footerAreasLabel}>
      <span class="font-bold text-white">{L.footerAreasLabel}:</span>
      {L.areaNames.map((a, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={`${areaPrefix}/locations/${a.slug}/`} class="hover:text-white hover:underline">{a.label}</a>
        </>
      ))}
    </nav>
    <p class="mx-auto max-w-6xl border-t border-white/10 px-4 py-5 text-center text-xs text-brand-100/70">
      © {year} {SITE.name} — {SITE.legalName} {L.rights}
    </p>
  </div>
</footer>
