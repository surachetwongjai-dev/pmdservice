---
import { SITE } from '../lib/site';

interface Props {
  class?: string;
  size?: 'md' | 'lg';
}
const { class: className = '', size = 'lg' } = Astro.props;
const pad = size === 'lg' ? 'px-7 py-3.5 text-base' : 'px-5 py-2.5 text-sm';
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  <a
    href={`tel:${SITE.phoneIntl}`}
    class:list={['inline-flex items-center gap-2 rounded-lg bg-brand-600 font-bold text-white shadow-card transition hover:bg-brand-700 hover:shadow-card-hover', pad]}
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1Z"/></svg>
    โทร {SITE.phoneDisplay}
  </a>
  <a
    href={SITE.lineUrl}
    target="_blank"
    rel="noopener"
    class:list={['inline-flex items-center gap-2 rounded-lg bg-line-600 font-bold text-white shadow-card transition hover:bg-line-700 hover:shadow-card-hover', pad]}
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.5 3 2 6.6 2 11.1c0 4 3.6 7.4 8.4 8 .3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.6s6-3.5 8.2-6C21.7 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8Z"/></svg>
    LINE: {SITE.lineId}
  </a>
</div>
