        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={b.icon} /></svg>
      </span>
      <span class="text-sm font-bold leading-snug">{b.title}</span>
      <span class="text-xs leading-relaxed text-ink-600">{b.desc}</span>
    </li>
  ))}
</ul>
