---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaSection from '../../components/CtaSection.astro';
import Testimonials from '../../components/Testimonials.astro';
import { SITE } from '../../lib/site';
import { t } from '../../lib/i18n';

const L = t('en');
const services = [
  {
    title: 'Hourly Maid Service',
    en: 'Book by the hour',
    desc: 'Hire a maid in Phuket by the hour, day or month from ฿400/hr — supplies included.',
    href: '/en/services/maid-hourly-phuket/',
    img: '/images/maid-kitchen-cabinet-cleaning-phuket.webp',
    alt: 'Phuket maid cleaning a kitchen by the hour',
    icon: 'M12 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 12c4.4 0 8 2.2 8 5v3H4v-3c0-2.8 3.6-5 8-5Z',
  },
  {
    title: 'Sofa, Mattress & Curtain',
    en: 'Steam Cleaning',
    desc: 'Hot-steam sanitising that kills dust mites and lifts deep stains with pro extraction gear.',
    href: '/en/services/sofa-cleaning-phuket/',
    img: '/images/sofa-steam-cleaning-phuket.webp',
    alt: 'Sofa steam cleaning in Phuket with a professional extraction machine',
    icon: 'M4 9V7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v2a3 3 0 0 1 3 3v5a2 2 0 0 1-2 2h-1v2h-2v-2H6v2H4v-2H3a2 2 0 0 1-2-2v-5a3 3 0 0 1 3-3Zm2 0h12V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2Z',
  },
  {
    title: 'Marble & Tile Polishing',
    en: 'Floor restoration',
    desc: 'Marble polishing ฿250/sqm, sandwash & wax ฿100/sqm — free trial patch before you decide.',
    href: '/en/services/marble-polishing-phuket/',
    img: '/images/marble-floor-polishing-phuket.webp',
    alt: 'Marble floor polishing in Phuket with a professional machine',
    icon: 'M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm12 0 4 4-4 4-4-4 4-4Z',
  },
  {
    title: 'Deep Cleaning',
    en: 'Homes & condos',
    desc: 'Big Cleaning from ฿4,000 — ideal before move-in, after renovation or a long vacancy.',
    href: '/en/services/deep-cleaning-phuket/',
    img: '/images/living-room-deep-cleaning-phuket.webp',
    alt: 'Deep cleaning in Phuket, a full top-to-bottom clean of every corner',
    icon: 'm12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2Z',
  },
  {
    title: 'Window Cleaning',
    en: 'Homes & buildings',
    desc: 'Streak-free glass for homes, offices and buildings — our team brings all the gear.',
    href: '/en/pricing/',
    img: '/images/window-squeegee-cleaning-phuket.webp',
    alt: 'Building window cleaning in Phuket with professional squeegee tools',
    icon: 'M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm1 2v6.5h6.5V5H5Zm8.5 0v6.5H20V5h-6.5ZM5 13.5V20h6.5v-6.5H5Zm8.5 0V20H20v-6.5h-6.5Z',
  },
  {
    title: 'More Services',
    en: 'Hotels · Airbnb · offices',
    desc: 'Cleaning for hotels, resorts, Airbnb and offices, plus full-service cleaning across Phuket.',
    href: '/en/pricing/',
    img: '/images/office-building-cleaning-phuket.webp',
    alt: 'Phuket cleaning team working on an office building',
    icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 5v4.6l3.5 2-1 1.7L11 12.7V7h2Z',
  },
];

const stats = [
  { big: 'First', small: 'to offer online maid booking in Phuket' },
  { big: '100%', small: 'police background-checked staff' },
  { big: '฿100,000', small: 'damage insurance on every job' },
  { big: 'All Phuket', small: 'on-site service in every district' },
];

const whyUs = [
  { title: 'Fully trained team', desc: 'Every maid is trained before their first real job', icon: 'M12 3 1 9l11 6 9-4.9V17h2V9L12 3ZM5 13.2V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.8l-7 3.8-7-3.8Z' },
  { title: 'Background-checked', desc: 'Verified by the national police department', icon: 'M12 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 12c4.4 0 8 2.2 8 5v3H4v-3c0-2.8 3.6-5 8-5Z' },
  { title: '฿100,000 insurance', desc: 'Every job is covered for accidental damage', icon: 'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z' },
  { title: 'Supplies included', desc: 'We bring all standard equipment and products', icon: 'M19.4 7.3 16.7 4.6a2 2 0 0 0-2.8 0l-9.3 9.3a2 2 0 0 0 0 2.8l2.7 2.7a2 2 0 0 0 2.8 0l9.3-9.3a2 2 0 0 0 0-2.8Z' },
  { title: 'Thai & English', desc: 'We serve both Thai and international customers', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3a15.6 15.6 0 0 0-1.2-5.2A8 8 0 0 1 19.9 11ZM12 4c.9 1.2 1.7 3.3 1.9 7h-3.8c.2-3.7 1-5.8 1.9-7Zm-3.7 1.8A15.6 15.6 0 0 0 7.1 11h-3a8 8 0 0 1 4.2-5.2ZM4.1 13h3c.2 1.9.6 3.7 1.2 5.2A8 8 0 0 1 4.1 13ZM12 20c-.9-1.2-1.7-3.3-1.9-7h3.8c-.2 3.7-1 5.8-1.9 7Zm3.7-1.8c.6-1.5 1-3.3 1.2-5.2h3a8 8 0 0 1-4.2 5.2Z' },
];

const works = [
  { img: '/images/team-window-cleaning-phuket.webp', alt: 'Phuket Maid Service team cleaning office building windows', label: 'Office building cleaning' },
  { img: '/images/armchair-steam-cleaning-phuket.webp', alt: 'Steam cleaning a fabric armchair in a Phuket condo', label: 'Sofa & fabric chairs' },
  { img: '/images/marble-floor-polishing-phuket.webp', alt: 'Polishing tile flooring with a machine in a Phuket office', label: 'Floor polishing & wax' },
  { img: '/images/bathroom-deep-cleaning-phuket.webp', alt: 'Deep cleaning a bathroom up to the window and high spots in Phuket', label: 'Bathroom deep cleaning' },
  { img: '/images/kitchen-cleaning-maid-phuket.webp', alt: 'Maid cleaning a kitchen in a Phuket home', label: 'Kitchen cleaning' },
  { img: '/images/mattress-drying-airbnb-phuket.webp', alt: 'Mattress cleaning and drying in a Phuket Airbnb', label: 'Airbnb turnover' },
];
---

<BaseLayout
  title="Phuket Maid Service | Cleaning & Maids Across Phuket"
  description="Cleaning service in Phuket: hourly maids from ฿400/hr, deep cleaning, steam sofa & mattress cleaning, marble polishing. First online maid booking in Phuket, background-checked staff, ฿100,000 insurance. Call +66 61 965 6292."
  altUrl="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 md:py-16 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-xs font-bold text-brand-700">
          <span class="h-2 w-2 rounded-full bg-line-600"></span>
          The first online maid booking service in Phuket
        </p>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-navy-900 md:text-5xl">
          Professional cleaning &amp;<br />
          <span class="text-brand-600">maid service</span> in Phuket<br />
          homes, condos, villas, offices
        </h1>
        <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-brand-500">บริการทำความสะอาด แม่บ้านภูเก็ต ครบวงจร</p>
        <p class="mt-4 max-w-xl leading-relaxed text-ink-600">
          Hourly maids from ฿400/hr, deep cleaning, hot-steam sofa &amp; mattress sanitising and marble
          polishing. Our team is fully trained, police background-checked, and every job carries ฿100,000 damage insurance.
        </p>

        <ul class="mt-6 grid max-w-xl grid-cols-2 gap-x-6 gap-y-3 text-sm font-semibold sm:grid-cols-4">
          {[
            'Background-checked',
            '฿100,000 insured',
            'Supplies included',
            'Thai & English',
          ].map((t) => (
            <li class="flex items-center gap-1.5">
              <svg class="h-4 w-4 shrink-0 text-line-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6 12-12-1.4-1.4-10.6 10.6Z"/></svg>
              {t}
            </li>
          ))}
        </ul>

        <CtaButtons class="mt-7" />
        <p class="mt-3 text-xs text-ink-600">{L.openingHours} — fast replies by phone and LINE.</p>
      </div>

      <div class="relative">
        <img
          src="/images/team-window-cleaning-phuket.webp"
          srcset="/images/team-window-cleaning-phuket-800.webp 800w, /images/team-window-cleaning-phuket.webp 1200w"
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt="Phuket Maid Service team cleaning the windows of a building in Phuket"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-card-hover sm:aspect-[4/3] lg:aspect-[4/4.4]"
          width="800"
          height="880"
          fetchpriority="high"
        />
        <div class="absolute -bottom-4 left-4 flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-card-hover">
          <span class="rounded-full bg-line-600/10 p-2 text-line-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm-1.2 13.6-3-3 1.4-1.4 1.6 1.6 4-4L16.2 10l-5.4 5.6Z"/></svg>
          </span>
          <span>
            <span class="block text-sm font-extrabold text-navy-900">Damage insurance</span>
            <span class="block text-xs text-ink-600">฿100,000 cover on every job</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-white py-16 md:py-24" aria-labelledby="services-title">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading eyebrow="Our Services" title="What we offer" />
      <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-relaxed text-ink-600">
        Pick the cleaning service you need — every job comes with a professional team and standard supplies included.
      </p>

      <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-brand-50 bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
            <a href={s.href} class="relative block" aria-label={s.title}>
              <img src={s.img} alt={s.alt} class="aspect-[16/10] w-full object-cover" width="640" height="400" loading="lazy" />
              <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 rounded-full border-4 border-white bg-brand-600 p-3 text-white shadow-card">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </span>
            </a>
            <div class="flex flex-1 flex-col items-center px-5 pb-6 pt-9 text-center">
              <h3 class="text-lg font-extrabold text-navy-900">
                <a href={s.href} class="hover:text-brand-600">{s.title}</a>
              </h3>
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-500">{s.en}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-600">{s.desc}</p>
              <a
                href={s.href}
                class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-brand-600 px-4 py-2 text-sm font-bold text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white"
              >
                Learn more
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/en/pricing/" class="inline-flex items-center gap-2 rounded-lg bg-navy-900 px-7 py-3.5 font-bold text-white shadow-card transition hover:bg-navy-800">
          See all prices
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="bg-brand-50 py-16 md:py-24" aria-labelledby="about-title">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 lg:grid-cols-2">
      <img
        src="/images/office-building-cleaning-phuket.webp"
        alt="Phuket Maid Service team cleaning a building in Phuket"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card-hover"
        width="800"
        height="600"
        loading="lazy"
      />
      <div>
        <SectionHeading eyebrow="About Us" title="Who we are" center={false} />
        <p class="mt-5 leading-relaxed text-ink-600">
          Phuket Maid Service (Phu Anda Co., Ltd.) is a full-service cleaning company in Phuket and the first
          to offer online maid booking. We look after private homes, condos, pool villas, Airbnb stays, hotels,
          resorts and offices with a team that is trained and police background-checked, backed by ฿100,000
          damage insurance. We serve both Thai and international customers.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-5">
          {stats.map((st) => (
            <div class="rounded-2xl bg-white p-4 text-center shadow-card">
              <dt class="sr-only">{st.small}</dt>
              <dd class="text-xl font-extrabold text-brand-600">{st.big}</dd>
              <dd class="mt-1 text-xs leading-relaxed text-ink-600">{st.small}</dd>
            </div>
          ))}
        </dl>
        <a href="/en/contact/" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 font-bold text-white shadow-card transition hover:bg-brand-700">
          Get in touch
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="relative bg-navy-900 py-16 md:py-20" aria-labelledby="why-title">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading eyebrow="Why Choose Us" title="Why customers pick us" light />
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {whyUs.map((w) => (
          <li class="flex flex-col items-center gap-3 text-center">
            <span class="rounded-full border border-white/20 bg-white/10 p-4 text-white">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={w.icon} /></svg>
            </span>
            <h3 class="text-sm font-bold text-white">{w.title}</h3>
            <p class="text-xs leading-relaxed text-brand-100/80">{w.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Our work -->
  <section class="bg-white py-16 md:py-24" aria-labelledby="work-title">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading eyebrow="Our Work" title="Recent jobs" />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {works.map((w) => (
          <figure class="overflow-hidden rounded-2xl border border-brand-50 bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
            <img src={w.img} alt={w.alt} class="aspect-[16/11] w-full object-cover" width="640" height="440" loading="lazy" />
            <figcaption class="px-4 py-3 text-center text-sm font-bold text-navy-900">{w.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <CtaSection />
</BaseLayout>
