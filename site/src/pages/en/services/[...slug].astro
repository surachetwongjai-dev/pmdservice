---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import CtaSection from '../../../components/CtaSection.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../../lib/schema';

// เนื้อหา EN อยู่ในไฟล์ *.en.md — slug ตัด .en ออก
export async function getStaticPaths() {
  const services = await getCollection('services', ({ data, id }) => !data.draft && id.endsWith('.en'));
  return services.map((entry) => ({ params: { slug: entry.id.replace(/\.en$/, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const baseSlug = entry.id.replace(/\.en$/, '');

const allEn = await getCollection('services', ({ data, id }) => !data.draft && id.endsWith('.en'));
const related = allEn.filter((s) => d.related.includes(s.id.replace(/\.en$/, '')));

const crumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Services', href: '/en/pricing/' },
  { label: d.title },
];

const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({
    name: d.title,
    description: d.metaDescription,
    serviceType: d.serviceType,
    url: `/en/services/${baseSlug}/`,
    image: d.heroImage,
    offer: d.offer,
  }),
  ...(d.faq.length ? [faqSchema(d.faq)] : []),
];

const altUrl = `/services/${baseSlug}/`;
---

<BaseLayout title={d.metaTitle} description={d.metaDescription} ogImage={d.heroImage} schema={schema} keywords={d.keywords} altUrl={altUrl}>
  <!-- Hero: H1 + price + CTA above the fold -->
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-6xl px-4 pt-5">
      <Breadcrumbs crumbs={crumbs} />
    </div>
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 pb-12 pt-6 lg:grid-cols-[1.1fr_1fr] lg:pb-16">
      <div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-navy-900 md:text-4xl">{d.title}</h1>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">{d.intro}</p>

        <div class="mt-6 inline-flex flex-wrap items-baseline gap-2 rounded-2xl border border-brand-100 bg-white px-5 py-4 shadow-card">
          <span class="text-3xl font-extrabold text-brand-600">{d.priceHighlight}</span>
          {d.priceUnit && <span class="text-sm font-semibold text-ink-600">{d.priceUnit}</span>}
          {d.priceNote && <span class="block w-full text-xs text-ink-600">{d.priceNote}</span>}
        </div>

        <CtaButtons class="mt-6" />
        <p class="mt-3 text-xs text-ink-600">Open daily 08:00 – 18:00 — fast replies in both Thai and English.</p>

        {d.coverage.length > 0 && (
          <div class="mt-6">
            <p class="text-xs font-bold uppercase tracking-wide text-ink-600">This service covers</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {d.coverage.map((c) => (
                <a href={c.href} class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-navy-900 shadow-card ring-1 ring-brand-100 transition hover:text-brand-600 hover:ring-brand-600">{c.label}</a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div>
        {d.heroVideo ? (
          <video
            class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card-hover"
            src={d.heroVideo}
            poster={d.heroPoster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={d.heroImageAlt}
          ></video>
        ) : (
          <img
            src={d.heroImage}
            srcset={`${d.heroImage.replace('.webp', '-800.webp')} 800w, ${d.heroImage} 1200w`}
            sizes="(min-width: 1024px) 45vw, 100vw"
            alt={d.heroImageAlt}
            class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card-hover"
            width="800"
            height="600"
            fetchpriority="high"
          />
        )}
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-y border-brand-50 bg-white py-8">
    <div class="mx-auto max-w-6xl px-4">
      <TrustBadges />
    </div>
  </section>

  <!-- Included + Price -->
  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-2">
      {d.included.length > 0 && (
        <div>
          <h2 class="text-2xl font-extrabold text-navy-900">What this service includes</h2>
          <ul class="mt-5 space-y-3">
            {d.included.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-600">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-line-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.4-3.8-3.8 1.4-1.4 2.4 2.4 5.2-5.2 1.4 1.4-6.6 6.6Z"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {d.priceRows.length > 0 && (
        <div>
          <h2 class="text-2xl font-extrabold text-navy-900">Pricing</h2>
          <div class="mt-5 overflow-hidden rounded-2xl border border-brand-100 shadow-card">
            <table class="w-full text-sm">
              <thead class="bg-navy-900 text-left text-white">
                <tr>
                  <th class="px-4 py-3 font-bold">Service</th>
                  <th class="px-4 py-3 text-right font-bold">Price</th>
                </tr>
              </thead>
              <tbody>
                {d.priceRows.map((row, i) => (
                  <tr class:list={[i % 2 === 1 && 'bg-brand-50/60']}>
                    <td class="px-4 py-3">
                      <span class="font-semibold text-navy-900">{row.label}</span>
                      {row.note && <span class="block text-xs text-ink-600">{row.note}</span>}
                    </td>
                    <td class="px-4 py-3 text-right font-extrabold text-brand-600">{row.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="mt-4 space-y-1.5 rounded-xl bg-brand-50 p-4 text-xs leading-relaxed text-ink-600">
            <li>• Prices exclude tax; we confirm the total clearly before every job.</li>
            <li>• Hourly maid service has a 2-hour minimum.</li>
            <li>• Beachfront or areas far from town: travel fee from ฿100–300 by distance.</li>
          </ul>
          <a href="/en/pricing/" class="mt-3 inline-block text-sm font-bold text-brand-600 hover:underline">See all prices →</a>
        </div>
      )}
    </div>
  </section>

  <!-- Steps -->
  {d.steps.length > 0 && (
    <section class="bg-brand-50 py-14 md:py-20">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading eyebrow="How to Book" title={`Book in ${d.steps.length} easy steps`} />
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          {d.steps.map((s, i) => (
            <li class="relative rounded-2xl bg-white p-6 pt-8 shadow-card">
              <span class="absolute -top-5 left-6 flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-lg font-extrabold text-white shadow-card">{i + 1}</span>
              <h3 class="font-extrabold text-navy-900">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Unique body content -->
  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 text-[15px] leading-relaxed text-ink-600 [&_a]:font-bold [&_a]:text-brand-600 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:text-navy-900 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-navy-900 [&_p]:mt-4 [&_strong]:font-bold [&_strong]:text-navy-900">
      <Content />
    </div>
  </section>

  <!-- Gallery -->
  {d.gallery.length > 0 && (
    <section class="bg-brand-50 py-14 md:py-20">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading eyebrow="Our Work" title="Real jobs by our team" />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {d.gallery.map((g) => (
            <figure class="overflow-hidden rounded-2xl bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
              <img src={g.src} alt={g.alt} class="aspect-[4/3] w-full object-cover" width="640" height="480" loading="lazy" />
              {g.caption && <figcaption class="px-4 py-3 text-center text-sm font-semibold text-navy-900">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {d.faq.length > 0 && (
    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-4">
        <SectionHeading eyebrow="FAQ" title="Frequently asked questions" />
        <div class="mt-8 space-y-3">
          {d.faq.map((f) => (
            <details class="group rounded-2xl border border-brand-100 bg-white shadow-card open:border-brand-600">
              <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-4 font-bold text-navy-900 [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="h-5 w-5 shrink-0 text-brand-600 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-ink-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related -->
  {related.length > 0 && (
    <section class="bg-white pb-14">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-xl font-extrabold text-navy-900">Often booked together</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <a href={`/en/services/${r.id.replace(/\.en$/, '')}/`} class="group flex items-center gap-4 rounded-2xl border border-brand-100 bg-white p-4 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
              <img src={r.data.heroImage} alt={r.data.heroImageAlt} class="h-16 w-20 rounded-xl object-cover" width="80" height="64" loading="lazy" />
              <span class="text-sm font-bold text-navy-900 group-hover:text-brand-600">{r.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related service areas -->
  {d.areaLinks.length > 0 && (
    <section class="bg-white pb-14">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-xl font-extrabold text-navy-900">Popular service areas for this service</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {d.areaLinks.map((a) => (
            <a href={a.href} class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-bold text-brand-700 transition hover:bg-brand-100">
              {a.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection title="Interested? Get a free quote today" />
</BaseLayout>
