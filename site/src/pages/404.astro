---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';

const links = [
  { label: 'แม่บ้านรายชั่วโมง', href: '/services/maid-hourly-phuket/' },
  { label: 'ซักโซฟา ที่นอน', href: '/services/sofa-cleaning-phuket/' },
  { label: 'ขัดพื้นหินอ่อน', href: '/services/marble-polishing-phuket/' },
  { label: 'Deep Cleaning', href: '/services/deep-cleaning-phuket/' },
  { label: 'ราคาบริการ', href: '/pricing/' },
  { label: 'ติดต่อเรา', href: '/contact/' },
];
---

<BaseLayout
  title="ไม่พบหน้าที่ต้องการ (404) | Phuket Maid Service"
  description="ไม่พบหน้าที่คุณกำลังหา — กลับหน้าแรกหรือเลือกบริการทำความสะอาดภูเก็ตที่ต้องการได้จากเมนูด้านล่าง"
>
  <section class="bg-gradient-to-b from-brand-50 to-white py-20 md:py-28">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <p class="text-7xl font-extrabold text-brand-100 md:text-8xl">404</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-navy-900 md:text-4xl">หน้านี้ถูกเก็บกวาดไปแล้ว</h1>
      <p class="mx-auto mt-4 max-w-md leading-relaxed text-ink-600">
        ไม่พบหน้าที่คุณกำลังหา อาจถูกย้ายหรือลบไปแล้ว — ลองเลือกจากบริการยอดนิยมด้านล่าง
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {links.map((l) => (
          <a href={l.href} class="rounded-lg border border-brand-100 bg-white px-4 py-2.5 text-sm font-bold text-navy-900 shadow-card transition hover:-translate-y-0.5 hover:text-brand-600 hover:shadow-card-hover">{l.label}</a>
        ))}
      </div>
      <CtaButtons class="mt-10 justify-center" />
    </div>
  </section>
</BaseLayout>
