---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaSection from '../../components/CtaSection.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const locations = await getCollection('locations', ({ data, id }) => !data.draft && !id.endsWith('.en'));
  return locations.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const altUrl = `/en/locations/${entry.id}/`;

// ลิงก์กลับไป pillar ทั้ง 4 (ข้อกำหนด BRIEF ข้อ 7)
const pillars = [
  { label: 'แม่บ้านรายชั่วโมง', href: '/services/maid-hourly-phuket/' },
  { label: 'ซักโซฟา ที่นอน ผ้าม่าน', href: '/services/sofa-cleaning-phuket/' },
  { label: 'ขัดพื้นหินอ่อน กระเบื้อง', href: '/services/marble-polishing-phuket/' },
  { label: 'Deep Cleaning บ้าน คอนโด', href: '/services/deep-cleaning-phuket/' },
];

const crumbs = [
  { label: 'หน้าแรก', href: '/' },
  { label: 'พื้นที่ให้บริการ', href: '/locations/' },
  { label: d.areaName },
];

const schema = [breadcrumbSchema(crumbs, Astro.url.pathname), ...(d.faq.length ? [faqSchema(d.faq)] : [])];
---

<BaseLayout title={d.metaTitle} description={d.metaDescription} ogImage={d.heroImage} schema={schema} altUrl={altUrl}>
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-6xl px-4 pt-5">
      <Breadcrumbs crumbs={crumbs} />
    </div>
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 pb-12 pt-6 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-navy-900 md:text-4xl">{d.title}</h1>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">{d.intro}</p>
        {d.travelNote && (
          <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-2 text-xs font-bold text-brand-700">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 5v4.6l3.5 2-1 1.7L11 12.7V7h2Z"/></svg>
            {d.travelNote}
          </p>
        )}
        <CtaButtons class="mt-6" />
      </div>
      <img src={d.heroImage} alt={d.heroImageAlt} class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card-hover" width="800" height="600" fetchpriority="high" />
    </div>
  </section>

  <section class="border-y border-brand-50 bg-white py-8">
    <div class="mx-auto max-w-6xl px-4">
      <TrustBadges />
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-2">
      {d.propertyTypes.length > 0 && (
        <div>
          <h2 class="text-2xl font-extrabold text-navy-900">ที่พักในย่าน{d.areaName}ที่เราดูแล</h2>
          <ul class="mt-5 space-y-3">
            {d.propertyTypes.map((p) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-600">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-line-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 1 11h3v10h7v-6h2v6h7V11h3L12 3Z"/></svg>
                {p}
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <h2 class="text-2xl font-extrabold text-navy-900">บริการยอดนิยมในย่านนี้</h2>
        <div class="mt-5 space-y-3">
          {(d.popularServices.length ? d.popularServices : pillars).map((s) => (
            <a href={s.href} class="flex items-center justify-between rounded-2xl border border-brand-100 bg-white px-5 py-3.5 text-sm font-bold text-navy-900 shadow-card transition hover:-translate-y-0.5 hover:text-brand-600 hover:shadow-card-hover">
              {s.label}
              <svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-50 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 text-[15px] leading-relaxed text-ink-600 [&_a]:font-bold [&_a]:text-brand-600 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:text-navy-900 [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-navy-900 [&_p]:mt-4 [&_strong]:font-bold [&_strong]:text-navy-900">
      <Content />
    </div>
  </section>

  {d.faq.length > 0 && (
    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-4">
        <SectionHeading eyebrow="FAQ" title="คำถามที่พบบ่อย" />
        <div class="mt-8 space-y-3">
          {d.faq.map((f) => (
            <details class="group rounded-2xl border border-brand-100 bg-white shadow-card open:border-brand-600">
              <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-4 font-bold text-navy-900 [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="h-5 w-5 shrink-0 text-brand-600 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-ink-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection title={`ต้องการแม่บ้านใน${d.areaName}? จองคิววันนี้`} />
</BaseLayout>
