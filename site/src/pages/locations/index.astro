---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaSection from '../../components/CtaSection.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

// หน้า hub รวมพื้นที่ให้บริการ — ดึงจาก content collection เพื่อให้ตรงกับหน้าจริงเสมอ
const locations = await getCollection('locations', ({ data, id }) => !data.draft && !id.endsWith('.en'));
locations.sort((a, b) => a.data.areaName.localeCompare(b.data.areaName, 'th'));

const crumbs = [{ label: 'หน้าแรก', href: '/' }, { label: 'พื้นที่ให้บริการ' }];
---

<BaseLayout
  title="พื้นที่ให้บริการทำความสะอาดทั่วภูเก็ต | Phuket Maid Service"
  description="Phuket Maid Service ให้บริการแม่บ้านและทำความสะอาดครอบคลุมทั่วเกาะภูเก็ต ป่าตอง กะตะ กะรน ราไวย์ เชิงทะเล บางเทา กมลา ในยาง ไม้ขาว ฉลอง และภูเก็ตทาวน์ ดูเวลาเดินทางและบริการยอดนิยมของแต่ละย่าน"
  schema={[breadcrumbSchema(crumbs, Astro.url.pathname)]}
  altUrl="/en/locations/"
>
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-6xl px-4 pt-5">
      <Breadcrumbs crumbs={crumbs} />
    </div>
    <div class="mx-auto max-w-6xl px-4 pb-10 pt-6 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-navy-900 md:text-4xl">
        พื้นที่ให้บริการทั่วภูเก็ต
      </h1>
      <p class="mx-auto mt-4 max-w-3xl leading-relaxed text-ink-600">
        ทีมงานตั้งฐานอยู่ที่ ต.ป่าคลอก อ.ถลาง และวิ่งงานครอบคลุมทั้งเกาะภูเก็ต ตั้งแต่ย่านโรงแรมหนาแน่นอย่างป่าตอง
        ไปจนถึงโซนพูลวิลล่าเงียบๆ แถบเชิงทะเลและไม้ขาว แต่ละย่านมีลักษณะที่พักและงานที่เจอบ่อยต่างกัน
        เลือกย่านของคุณเพื่อดูรายละเอียดบริการที่เหมาะกับที่พักแถวนั้นโดยเฉพาะ
      </p>
      <CtaButtons class="mt-6 justify-center" />
      <p class="mt-3 text-xs text-ink-600">{SITE.openingHours} — ตอบไวทั้งภาษาไทยและอังกฤษ</p>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {locations.map((loc) => (
          <a
            href={`/locations/${loc.id}/`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover"
          >
            <img
              src={loc.data.heroImage}
              srcset={`${loc.data.heroImage.replace('.webp', '-800.webp')} 800w, ${loc.data.heroImage} 1200w`}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
              alt={loc.data.heroImageAlt}
              class="aspect-[4/3] w-full object-cover"
              width="640"
              height="480"
              loading="lazy"
            />
            <div class="flex flex-1 flex-col gap-2 p-5">
              <h2 class="text-lg font-extrabold text-navy-900 group-hover:text-brand-600">
                แม่บ้าน{loc.data.areaName}
              </h2>
              {loc.data.travelNote && (
                <p class="text-sm leading-relaxed text-ink-600">{loc.data.travelNote}</p>
              )}
              {loc.data.popularServices.length > 0 && (
                <div class="mt-1 flex flex-wrap gap-1.5">
                  {loc.data.popularServices.slice(0, 3).map((s) => (
                    <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[11px] font-semibold text-brand-700">
                      {s.label}
                    </span>
                  ))}
                </div>
              )}
              <span class="mt-auto pt-3 text-sm font-bold text-brand-600">ดูบริการในย่านนี้ →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-brand-100 bg-brand-50 p-5 text-sm leading-relaxed text-ink-600">
        <p class="mb-2 font-bold text-navy-900">เรื่องค่าเดินทาง</p>
        <ul class="space-y-1.5">
          <li>• พื้นที่หน้าหาดหรือไกลจากตัวเมือง มีค่าเดินทางเริ่มต้น 100–300 บาท ตามระยะทาง แจ้งชัดเจนก่อนรับงานเสมอ</li>
          <li>• ไม่เห็นย่านของคุณในรายการ? เราไปได้ทั่วภูเก็ตครับ ทักไลน์แจ้งพิกัดมาได้เลย</li>
          <li>• งานเหมารายเดือนสำหรับโรงแรม พูลวิลล่า และสำนักงาน มีราคาแพ็กเกจพิเศษ</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-brand-50 bg-white pb-14">
    <div class="mx-auto max-w-6xl px-4 pt-10">
      <TrustBadges />
    </div>
  </section>

  <CtaSection title="อยู่ย่านไหนก็จองได้ ทักไลน์แจ้งพิกัดมาได้เลย" />
</BaseLayout>
